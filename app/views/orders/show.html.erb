<h1 class="text-2xl font-bold text-gray-900 mb-6">Order #<%= @order.id %></h1>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <div class="grid grid-cols-2 gap-4">
    <div>
      <p class="text-sm text-gray-500">Status</p>
      <p class="font-semibold"><%= @order.status.capitalize %></p>
    </div>
    <div>
      <p class="text-sm text-gray-500">Total</p>
      <p class="text-xl font-bold text-indigo-600">$<%= number_with_precision(@order.total, precision: 2) %></p>
    </div>
  </div>
</div>

<h2 class="text-lg font-bold text-gray-900 mb-4">Items</h2>
<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Product</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Price</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Qty</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Total</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @order.order_items.each do |item| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= item.product.name %></td>
          <td class="px-6 py-4 text-sm text-gray-600">$<%= number_with_precision(item.price, precision: 2) %></td>
          <td class="px-6 py-4 text-sm text-gray-600"><%= item.quantity %></td>
          <td class="px-6 py-4 text-sm text-gray-900">$<%= number_with_precision(item.price * item.quantity, precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
