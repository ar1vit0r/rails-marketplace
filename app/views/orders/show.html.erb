<h1 class="text-2xl font-bold text-gray-100 mb-6">Order #<%= @order.id %></h1>

<div class="bg-gray-800 border border-gray-700 rounded-lg p-6 mb-6">
  <div class="grid grid-cols-2 gap-4">
    <div>
      <p class="text-sm text-gray-400">Status</p>
      <p class="font-semibold">
        <span class="<%= status_color(@order.status) %> px-2 py-1 rounded text-sm">
          <%= @order.status.capitalize %>
        </span>
      </p>
    </div>
    <div>
      <p class="text-sm text-gray-400">Total</p>
      <p class="text-xl font-bold text-cyan-400">$<%= number_with_precision(@order.total, precision: 2) %></p>
    </div>
  </div>
</div>

<% if @order.pending? %>
  <div class="bg-yellow-900/30 border border-yellow-700 rounded-lg p-4 mb-6">
    <p class="text-yellow-300 mb-3">This order is awaiting payment.</p>
    <%= form_with url: order_checkout_path(@order), method: :post do |f| %>
      <%= f.submit "Pay with Stripe", class: "bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 cursor-pointer" %>
    <% end %>
  </div>
<% end %>

<% if @order.paid? %>
  <div class="bg-green-900/30 border border-green-700 rounded-lg p-4 mb-6">
    <p class="text-green-300">Payment confirmed. Thank you!</p>
  </div>
<% end %>

<h2 class="text-lg font-bold text-gray-100 mb-4">Items</h2>
<div class="bg-gray-800 border border-gray-700 rounded-lg overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-700">
      <tr>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-300">Product</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-300">Price</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-300">Qty</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-300">Total</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-700">
      <% @order.order_items.each do |item| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium text-gray-100"><%= item.product.name %></td>
          <td class="px-6 py-4 text-sm text-gray-400">$<%= number_with_precision(item.price, precision: 2) %></td>
          <td class="px-6 py-4 text-sm text-gray-400"><%= item.quantity %></td>
          <td class="px-6 py-4 text-sm text-gray-100">$<%= number_with_precision(item.price * item.quantity, precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
