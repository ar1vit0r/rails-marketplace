<h1 class="text-2xl font-bold text-gray-900 mb-6">Shopping Cart</h1>

<% if @cart_items.empty? %>
  <div class="bg-white rounded-lg shadow p-8 text-center">
    <p class="text-gray-600 mb-4">Your cart is empty</p>
    <%= link_to "Browse Products", products_path, class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700" %>
  </div>
<% else %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Product</th>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Price</th>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Qty</th>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Total</th>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-500"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @cart_items.each do |item| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= item.product.name %></td>
            <td class="px-6 py-4 text-sm text-gray-600">$<%= number_with_precision(item.product.price, precision: 2) %></td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= item.quantity %></td>
            <td class="px-6 py-4 text-sm text-gray-900">$<%= number_with_precision(item.product.price * item.quantity, precision: 2) %></td>
            <td class="px-6 py-4 text-sm">
              <%= button_to "Remove", cart_remove_path(item), method: :delete, class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-gray-50">
        <tr>
          <td colspan="3" class="px-6 py-4 text-right font-semibold">Total:</td>
          <td class="px-6 py-4 text-lg font-bold text-indigo-600">$<%= number_with_precision(current_cart.total, precision: 2) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="mt-6 flex justify-end">
    <%= form_with url: orders_path, method: :post do |f| %>
      <%= f.submit "Place Order", class: "bg-green-600 text-white px-8 py-3 rounded-lg hover:bg-green-700 cursor-pointer text-lg" %>
    <% end %>
  </div>
<% end %>
