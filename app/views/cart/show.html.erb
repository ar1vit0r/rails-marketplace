<h1 class="text-2xl font-bold text-gray-100 mb-6">Shopping Cart</h1>

<% if @cart_items.empty? %>
  <div class="bg-gray-800 border border-gray-700 rounded-lg p-8 text-center">
    <p class="text-gray-400 mb-4">Your cart is empty</p>
    <%= link_to "Browse Products", products_path, class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700" %>
  </div>
<% else %>
  <div class="bg-gray-800 border border-gray-700 rounded-lg overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-700">
        <tr>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-300">Product</th>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-300">Price</th>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-300">Qty</th>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-300">Total</th>
          <th class="px-6 py-3 text-left text-sm font-medium text-gray-300"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-700">
        <% @cart_items.each do |item| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-100"><%= item.product.name %></td>
            <td class="px-6 py-4 text-sm text-gray-400">$<%= number_with_precision(item.product.price, precision: 2) %></td>
            <td class="px-6 py-4 text-sm text-gray-400"><%= item.quantity %></td>
            <td class="px-6 py-4 text-sm text-gray-100">$<%= number_with_precision(item.product.price * item.quantity, precision: 2) %></td>
            <td class="px-6 py-4 text-sm">
              <%= button_to "Remove", cart_remove_path(item), method: :delete, class: "text-red-400 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-gray-700">
        <tr>
          <td colspan="3" class="px-6 py-4 text-right font-semibold text-gray-300">Total:</td>
          <td class="px-6 py-4 text-lg font-bold text-cyan-400">$<%= number_with_precision(current_cart.total, precision: 2) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="mt-6 flex justify-end">
    <%= form_with url: orders_path, method: :post do |f| %>
      <%= f.submit "Place Order", class: "bg-green-600 text-white px-8 py-3 rounded-lg hover:bg-green-700 cursor-pointer text-lg" %>
    <% end %>
  </div>
<% end %>
