<%= form_with model: [:admin, category], class: "space-y-4" do |f| %>
  <% if category.errors.any? %>
    <div class="bg-red-50 text-red-800 px-4 py-2 rounded">
      <% category.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 3, class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "Cancel", admin_categories_path, class: "bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300" %>
  </div>
<% end %>
