<h1 class="text-2xl font-bold text-gray-900 mb-6">Admin Dashboard</h1>

<div class="grid gap-6 md:grid-cols-3 mb-8">
  <%= link_to admin_products_path, class: "bg-white rounded-lg shadow p-6 hover:shadow-md transition" do %>
    <h2 class="text-lg font-semibold text-gray-900">Products</h2>
    <p class="text-3xl font-bold text-indigo-600"><%= @products %></p>
  <% end %>
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900">Orders</h2>
    <p class="text-3xl font-bold text-indigo-600"><%= @orders %></p>
  </div>
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900">Users</h2>
    <p class="text-3xl font-bold text-indigo-600"><%= @users %></p>
  </div>
</div>

<h2 class="text-xl font-bold text-gray-900 mb-4">Recent Orders</h2>
<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Order</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">User</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Total</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @recent_orders.each do |order| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium text-gray-900">#<%= order.id %></td>
          <td class="px-6 py-4 text-sm text-gray-600"><%= order.user.email %></td>
          <td class="px-6 py-4 text-sm text-gray-900">$<%= number_with_precision(order.total, precision: 2) %></td>
          <td class="px-6 py-4 text-sm"><%= order.status.capitalize %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
