<%= form_with model: [:admin, product], class: "space-y-4" do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 text-red-800 px-4 py-2 rounded">
      <% product.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <div>
    <%= f.label :category_id, class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select category" }, class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 4, class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :price, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :price, step: 0.01, class: "border rounded-lg px-4 py-2 w-full" %>
    </div>
    <div>
      <%= f.label :stock, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :stock, class: "border rounded-lg px-4 py-2 w-full" %>
    </div>
  </div>
  <div class="flex gap-2">
    <%= f.submit class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "Cancel", admin_products_path, class: "bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300" %>
  </div>
<% end %>
