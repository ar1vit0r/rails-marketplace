<div class="text-center mb-8">
  <h1 class="text-4xl font-bold text-gray-100 mb-2">Discover Amazing Products</h1>
  <p class="text-gray-400">Shop from our curated collection</p>
</div>

<h2 class="text-xl font-bold text-gray-100 mb-4">Categories</h2>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <% @categories.each do |category| %>
    <%= link_to category_path(category), class: "bg-gray-800 border border-gray-700 rounded-lg p-4 text-center hover:border-cyan-500 transition" do %>
      <h3 class="font-semibold text-gray-100"><%= category.name %></h3>
      <p class="text-sm text-gray-400"><%= category.products.count %> products</p>
    <% end %>
  <% end %>
</div>

<h2 class="text-xl font-bold text-gray-100 mb-4">Featured Products</h2>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
  <% @products.each do |product| %>
    <%= link_to product_path(product), class: "bg-gray-800 border border-gray-700 rounded-lg overflow-hidden hover:border-cyan-500 transition" do %>
      <div class="h-48 bg-gray-700"></div>
      <div class="p-4">
        <h3 class="font-semibold text-gray-100"><%= product.name %></h3>
        <p class="text-sm text-gray-400"><%= product.category.name %></p>
        <p class="text-lg font-bold text-cyan-400 mt-2">$<%= number_with_precision(product.price, precision: 2) %></p>
      </div>
    <% end %>
  <% end %>
</div>
