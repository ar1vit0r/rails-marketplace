<%= link_to "← Back to products", products_path, class: "text-cyan-400 hover:underline mb-4 inline-block" %>

<div class="bg-gray-800 border border-gray-700 rounded-lg p-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="h-96 bg-gray-700 rounded-lg"></div>
    <div>
      <h1 class="text-3xl font-bold text-gray-100 mb-2"><%= @product.name %></h1>
      <p class="text-gray-400 mb-4"><%= @product.category.name %></p>
      <p class="text-3xl font-bold text-cyan-400 mb-4">$<%= number_with_precision(@product.price, precision: 2) %></p>
      <p class="text-gray-300 mb-6"><%= @product.description %></p>
      <p class="text-sm text-gray-400 mb-6"><%= @product.stock %> in stock | Sold by <%= @product.user.email %></p>

      <%= form_with url: cart_add_path(@product), method: :post, class: "inline" do |f| %>
        <%= f.submit "Add to Cart", class: "bg-cyan-600 text-white px-6 py-3 rounded-lg hover:bg-cyan-700 cursor-pointer text-lg" %>
      <% end %>
    </div>
  </div>
</div>
